# Sourced by both ~/.profile (login) and ~/.bashrc (interactive/non-login).
# Config for the rt/rmount remote-sandbox bridge -> mempool@mempool.lan
#
# NOTE: Claude Code's tool shells run with BASH_ENV=lmod and source neither
# .bashrc nor .profile, so rt/rmount carry these same values as built-in
# defaults. This file is for your interactive terminals.

case ":$PATH:" in *":$HOME/bin:"*) ;; *) PATH="$HOME/bin:$PATH" ;; esac
export PATH

export RT_HOST=sandbox            # ssh alias -> mempool@mempool.lan
export RT_WORKDIR=/home/mempool   # remote working tree (the whole home dir)
export RT_MOUNT=$HOME/sandbox     # local sshfs mountpoint
export RT_SESSION=rt              # tmux session name on the sandbox
export RT_TIMEOUT=900             # seconds before rt gives up (use --bg for builds)
