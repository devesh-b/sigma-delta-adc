[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 100
prove: mode prove
cover: mode cover
cover: depth 100
multiclock off

[engines]
bmc: smtbmc yices
prove: abc pdr
cover: smtbmc yices

[script]
read_verilog -DFORMAL c9_cfg.v c9_core.v c9_dec.v c9_fsdiv.v c9_rdbus.v c9_seq.v tt_um_sd_adc_c9.v
read_verilog -formal c9_props.sv
prep -top c9_formal

